	partition dCalendario = m
		mode: import
		source = ```
				let
				    // Definir datas inicial e final
				    StartDate = #date(Ano_Inicial, 01, 01),
				    EndDate = #date(Date.Year(DateTime.LocalNow()) + 1, 12, 31),
				    DayCount = Duration.Days(Duration.From(EndDate - StartDate)) + 1, 
				    ListDates = List.Dates(StartDate, DayCount, #duration(1,0,0,0)),
				    
				    // Criar tabela a partir da lista de datas
				    TableFromList = Table.FromList(ListDates, Splitter.SplitByNothing()),
				    ChangedType = Table.TransformColumnTypes(TableFromList,{{"Column1", type date}}),
				    RenamedColumns = Table.RenameColumns(ChangedType,{{"Column1", "Data"}}),
				    
				    // Colunas base
				    Ano = Table.AddColumn(RenamedColumns, "Ano", each Date.Year([Data]), Int64.Type),
				    Mes = Table.AddColumn(Ano, "Mes", each Date.MonthName([Data]), type text),
				    #"Mes Abreviado" = Table.AddColumn(Mes, "Mesab", each Text.Start([Mes], 3), type text),
				    #"Numero do Mes" = Table.AddColumn(#"Mes Abreviado", "MesNum", each Date.Month([Data]), Int64.Type),
				    
				    // Colunas de AnoAtual e MesAtual usando data atual do sistema
				    DataAtual = DateTime.Date(DateTime.LocalNow()),
				    AnoAtual = Table.AddColumn(#"Numero do Mes", "AnoAtual", 
				        each if Date.Year([Data]) = Date.Year(DataAtual) 
				             then "Ano Atual" 
				             else Text.From(Date.Year([Data]))),
				    
				    MesAtual = Table.AddColumn(AnoAtual, "MesAtual",
				        each if Date.Year([Data]) = Date.Year(DataAtual) and Date.Month([Data]) = Date.Month(DataAtual)
				             then "Mês Atual"
				             else Text.Proper(Date.MonthName([Data]))),
				    
				    // Continuação das colunas originais
				    #"Inicio do Mes" = Table.AddColumn(MesAtual, "InicioMes", each Date.StartOfMonth([Data]), type date),
				    #"Final do Mes" = Table.AddColumn(#"Inicio do Mes", "FinalMes", each Date.EndOfMonth([Data]), type date),
				    #"Mes do Ano" = Table.AddColumn(#"Final do Mes", "MesAno", each [Mesab] & "/" & Text.From([Ano]), type text),
				    MesAnoNum = Table.AddColumn(#"Mes do Ano", "MesAnoNum", each [Ano] * 100 + [MesNum], Int64.Type),
				    Dia = Table.AddColumn(MesAnoNum, "Dia", each Date.Day([Data]), Int64.Type),
				    SemanaNum = Table.AddColumn(Dia, "SemanaNum", each Date.WeekOfYear([Data]), Int64.Type),
				    #"Inicio Semana" = Table.AddColumn(SemanaNum, "InicioSemana", each Date.StartOfWeek([Data]), type date),
				    #"Final Semana" = Table.AddColumn(#"Inicio Semana", "FinalSemana", each Date.EndOfWeek([Data]), type date),
				    SemanaAno = Table.AddColumn(#"Final Semana", "SemanaAno", each "S" &
				        Text.PadStart(Text.From([SemanaNum]), 2, "0") & "/" & Text.From([Ano]), type text),
				    SemanaAnoNum = Table.AddColumn(SemanaAno, "SemanaAnoNum", each [Ano] * 100 + [SemanaNum], Int64.Type),
				    DiaSemana = Table.AddColumn(SemanaAnoNum, "DiaSemana", each Date.DayOfWeekName([Data]), type text),
				    DiaSemanaAb = Table.AddColumn(DiaSemana, "DiaSemanaAb", each Text.Start([DiaSemana], 3), type text),
				    DiaSemanaNum = Table.AddColumn(DiaSemanaAb, "DiaSemanaNum", each Date.DayOfWeek([Data]), Int64.Type),
				    TrimestreNum = Table.AddColumn(DiaSemanaNum, "TrimestreNum", each Date.QuarterOfYear([Data]), Int64.Type),
				    Trimestre = Table.AddColumn(TrimestreNum, "Trimestre", each "T" & Text.From([TrimestreNum]), type text),
				    TrimestreAno = Table.AddColumn(Trimestre, "TrimestreAno", each [Trimestre] & "/" & Text.From([Ano]), type text),
				    TrimestreAnoNum = Table.AddColumn(TrimestreAno, "TrimestreAnoNum", each [Ano] * 10 + [TrimestreNum], Int64.Type),
				    Semestre = Table.AddColumn(TrimestreAnoNum, "Semestre", 
				        each if [MesNum] >= 1 and [MesNum] <= 6 then "Semestre1" else "Semestre2", type text),
				    SemestreNum = Table.AddColumn(Semestre, "SemestreNum",
				        each if [MesNum] >= 1 and [MesNum] <= 6 then 1 else 2, Int64.Type),
				    SemestreAno = Table.AddColumn(SemestreNum, "SemestreAno", 
				        each "Sem" & Text.From([SemestreNum]) & "/" & Text.From([Ano]), type text),
				    #"Tipo Alterado" = Table.TransformColumnTypes(SemestreAno,{{"SemestreNum", Int64.Type}}),
				    SemestreAnoNum = Table.AddColumn(#"Tipo Alterado", "SemestreAnoNum", each [Ano] * 100 + [SemestreNum], Int64.Type),
				    #"Coluna Mesclada Inserida" = Table.AddColumn(SemestreAnoNum, "SemanaNumAno", 
				        each Text.Combine({Text.From([SemanaNum], "pt-BR"), Text.From([Ano], "pt-BR")}, ""), Int64.Type),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Coluna Mesclada Inserida",{{"SemanaNumAno", Int64.Type}}),
				    #"Semana do Mês Inserida" = Table.AddColumn(#"Tipo Alterado1", "Semana do Mês", each Date.WeekOfMonth([Data]), Int64.Type),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Semana do Mês Inserida",{{"Semana do Mês", "SemanaMesNum"}}),
				    #"Coluna Mesclada Inserida1" = Table.AddColumn(#"Colunas Renomeadas", "SemanaMesAno", 
				        each Text.Combine({Text.From([Ano], "pt-BR"), Text.From([MesNum], "pt-BR"), Text.From([SemanaMesNum], "pt-BR")}, ""), type text),
				    #"Tipo Alterado2" = Table.TransformColumnTypes(#"Coluna Mesclada Inserida1",{{"SemanaMesAno", Int64.Type}, {"AnoAtual", type text}, {"MesAtual", type text}})
				in
				    #"Tipo Alterado2"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

