	column antecipados
		dataType: int64
		formatString: 0
		lineageTag: f0c91bc9-8bc3-4dff-8e8e-a3948586733b
		summarizeBy: sum
		sourceColumn: antecipados

		annotation SummarizationSetBy = Automatic

	column prazo
		dataType: int64
		formatString: 0
		lineageTag: a139a45f-b045-4e39-ac80-432e2894e3a5
		summarizeBy: sum
		sourceColumn: prazo

		annotation SummarizationSetBy = Automatic

	column conf =
			//DIVIDE(fRecebidos[vr_bruto_final]; fRecebidos[vr_bruto_final]; 0)
			IF(
			    fRecebidos[liquido_rateado] < fRecebidos[bruto_rateado],
			    DIVIDE(fRecebidos[liquido_rateado], fRecebidos[vr_bruto_final], 0),
			    DIVIDE(fRecebidos[bruto_rateado], fRecebidos[vr_bruto_final], 0)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9db16fdd-0eb3-461e-87bd-585a4cc2fadc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column comissao_faturamento =
			
			VAR vCodVenda = fRecebidos[fat_cod_venda]
			RETURN
			COALESCE(
			    CALCULATE(
			        SUM(fVendas[vr_comissao]),
			        FILTER(
			            fVendas,
			            fVendas[cod_venda] = vCodVenda
			        )
			    ),
			    0
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 9d735792-f9bf-4a8b-a3f7-513e56dfcee0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column comissao_recebimento = ```
			fRecebidos[comissao_faturamento] * fRecebidos[conf]
			// VAR vFatura = fRecebidos[fat_cod_fatura]
			// VAR vPerc_Venda_Rateado = fRecebidos[conf]
			// VAR vSomaConfTotal = 
			//     CALCULATE(
			//         SUM(fRecebidos[conf]);
			//         ALLEXCEPT(fRecebidos; fRecebidos[fat_cod_fatura])
			//     )
			// RETURN
			// IF(
			//     vSomaConfTotal > 1; 
			//     [Comissao Faturamento] * [Conf] / vSomaConfTotal;
			//     [Comissao Faturamento] * [Conf]
			// )
			```
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: ab0aa8d0-4d88-43b4-9428-9f335628f6ff
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column vr_bruto_final = fRecebidos[fat_vr_bruto] - fRecebidos[fat_vr_descontos] + fRecebidos[fat_vr_acrescimos]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 982e1a71-42a0-4d74-87f9-3f57121f71ae
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column cod_fatura/prc_cod_parc = CONCATENATE(fRecebidos[fat_cod_fatura], fRecebidos[prc_cod_parc] & fRecebidos[bxa_tipo_baixa])
		lineageTag: 7665f885-13e0-4fd3-9a32-8496cc24a664
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Descricao_Forma_Pgto =
			
