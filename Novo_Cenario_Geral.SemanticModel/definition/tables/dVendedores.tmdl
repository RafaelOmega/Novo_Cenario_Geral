	partition dVendedores = m
		mode: import
		queryGroup: PESSOAS
		source =
				let
				    Fonte = PowerPlatform.Dataflows(null),
				    Workspaces = Fonte{[Id="Workspaces"]}[Data],
				    #"9a5d1c56-f61c-459a-878e-7b24c649eafd" = Workspaces{[workspaceId="9a5d1c56-f61c-459a-878e-7b24c649eafd"]}[Data],
				    #"ef9589b0-b641-4a7d-aa71-3aea97f930bd" = #"9a5d1c56-f61c-459a-878e-7b24c649eafd"{[dataflowId="ef9589b0-b641-4a7d-aa71-3aea97f930bd"]}[Data],
				    dVendedores_ = #"ef9589b0-b641-4a7d-aa71-3aea97f930bd"{[entity="dVendedores",version=""]}[Data],
				    #"Colunas Renomeadas" = Table.RenameColumns(dVendedores_,{{"cod_pessoa", "cod_vendedor"}, {"razao_social", "vendedor"}}),
				    #"Linhas Filtradas" = Table.SelectRows(#"Colunas Renomeadas", each [data_cadastro] <> null),
				    #"Coluna Mesclada Inserida" = Table.AddColumn(#"Linhas Filtradas", "Cód + Vendedor", each Text.Combine({Text.From([cod_vendedor], "pt-BR"), [vendedor]}, " - "), type text)
				in
				    #"Coluna Mesclada Inserida"

