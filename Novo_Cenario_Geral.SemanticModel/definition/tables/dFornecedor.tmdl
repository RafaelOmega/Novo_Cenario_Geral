	partition dFornecedor = m
		mode: import
		queryGroup: PESSOAS
		source =
				let
				    Fonte = PowerPlatform.Dataflows(null),
				    Workspaces = Fonte{[Id="Workspaces"]}[Data],
				    #"9a5d1c56-f61c-459a-878e-7b24c649eafd" = Workspaces{[workspaceId="9a5d1c56-f61c-459a-878e-7b24c649eafd"]}[Data],
				    #"ef9589b0-b641-4a7d-aa71-3aea97f930bd" = #"9a5d1c56-f61c-459a-878e-7b24c649eafd"{[dataflowId="ef9589b0-b641-4a7d-aa71-3aea97f930bd"]}[Data],
				    dFornecedor_ = #"ef9589b0-b641-4a7d-aa71-3aea97f930bd"{[entity="dFornecedor",version=""]}[Data],
				    #"Coluna Mesclada Inserida" = Table.AddColumn(dFornecedor_, "Cod + Fornecedor", each Text.Combine({Text.From([cod_fornecedor], "pt-BR"), [fornecedor]}, " - "), type text)
				in
				    #"Coluna Mesclada Inserida"

