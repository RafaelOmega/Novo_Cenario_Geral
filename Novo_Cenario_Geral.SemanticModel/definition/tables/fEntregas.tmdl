	column cfop_cod
		dataType: int64
		formatString: 0
		lineageTag: 07655cab-6c8a-4b2c-a849-3369feb35f7f
		summarizeBy: sum
		sourceColumn: cfop_cod

		annotation SummarizationSetBy = Automatic

	column pis_aliq_Nfe =
			
			VAR vVenda = fEntregas[vend_cod_venda]
			VAR vProd  = fEntregas[cod_prod]
			VAR vAliq =
			    CALCULATE(
			        MAX(fNotas_Fiscais_Saida[pis_aliq]),
			        FILTER(
			            fNotas_Fiscais_Saida,
			            fNotas_Fiscais_Saida[venda_cod_venda] = vVenda &&
			            fNotas_Fiscais_Saida[cod_prod] = vProd &&
			            fNotas_Fiscais_Saida[cod_cfop] <> "5929"
			        )
			    )
			RETURN
			COALESCE(vAliq, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c29dd986-8aa2-47ef-abb2-134e46d8340b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column cofins_aliq_Nfe =
			
			VAR vVenda = fEntregas[vend_cod_venda]
			VAR vProd  = fEntregas[cod_prod]
			VAR vAliq =
			    CALCULATE(
			        MAX(fNotas_Fiscais_Saida[cofins_aliq]),
			        FILTER(
			            fNotas_Fiscais_Saida,
			            fNotas_Fiscais_Saida[venda_cod_venda] = vVenda &&
			            fNotas_Fiscais_Saida[cod_prod] = vProd &&
			            fNotas_Fiscais_Saida[cod_cfop] <> "5929"
			        )
			    )
			RETURN
			COALESCE(vAliq, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 27d1389f-9ef6-49e0-949d-108a2a17287e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column pis_cofins_nfe = fEntregas[pis_aliq_Nfe] + fEntregas[cofins_aliq_Nfe]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bb115f18-4b7b-471b-9095-556bde05d5d9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column icms_aliq_Nfe =
			
			VAR vVenda = fEntregas[vend_cod_venda]
			VAR vProd  = fEntregas[cod_prod]
			VAR vAliq =
			    CALCULATE(
			        MAX(fNotas_Fiscais_Saida[icms_aliq]),
			        FILTER(
			            fNotas_Fiscais_Saida,
			            fNotas_Fiscais_Saida[venda_cod_venda] = vVenda &&
			            fNotas_Fiscais_Saida[cod_prod] = vProd &&
			            fNotas_Fiscais_Saida[cod_cfop] <> "5929"
			        )
			    )
			RETURN
			COALESCE(vAliq, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 46c19458-4093-48a5-a86f-db25ef8d2b41
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column pis_cofins_aliq = fEntregas[pis_aliq] + fEntregas[cofins_aliq]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 96714cf2-07d9-460d-a642-ad9a831a9cb8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Vr_Liquido_Ajustado =
			
			VAR vVrLiquido = COALESCE(fEntregas[vr_liquido], 0)
			
			VAR vDescVenda = COALESCE(fEntregas[vr_desconto_venda], 0)
			VAR vDesc       = COALESCE(fEntregas[vr_desconto], 0)
			VAR vDifDesc =
			    IF(vDescVenda <> vDesc, vDescVenda - vDesc, 0)
			
			VAR vAcrVenda = COALESCE(fEntregas[vr_acrescimo_venda], 0)
			VAR vAcr      = COALESCE(fEntregas[vr_acrescimo], 0)
			VAR vDifAcr =
			    IF(vAcrVenda <> vAcr, vAcrVenda - vAcr, 0)
			
			RETURN
			    vVrLiquido - vDifDesc + vDifAcr
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: c7df7175-640d-4eab-96da-557d6a928e7b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column vr_unitario_liquido = DIVIDE(fEntregas[Vr_Liquido_Ajustado], fEntregas[qtd], 0)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: ecf2df8d-6bfc-467a-9737-66277cc609e2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column comissao_prazo =
			
			VAR vVendedor = fEntregas[cod_vendedor]
			VAR vUnit     = fEntregas[vr_unitario_liquido]
			VAR vData     = fEntregas[DATA]
			VAR vPrecoPrazo = RELATED(dProdutos[preco_prazo])
			VAR vPrecoVista = RELATED(dProdutos[preco_vista])
			RETURN
			IF(
			    NOT ( vVendedor IN {165,234,236,237,238,248,250,2858,2885,3025,3065,3174} ),
			    0,
			    IF(
			        vVendedor = 234,
			        0.05,
			        IF(
			            vVendedor = 3174,
			            IF(
			                vData <= DATE(2026, 1, 31),
			                SWITCH(
			                    TRUE(),
			                    vUnit >= vPrecoPrazo, 0.05,
			                    vUnit < vPrecoPrazo && vUnit >= vPrecoVista, 0.04,
			                    vUnit < vPrecoVista, 0.02,
			                    RELATED(dProdutos[perc_comissao_prazo])
			                ),
			                0.04
			            ),
			            RELATED(dProdutos[perc_comissao_prazo])
			        )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ad4307d4-45d1-446e-a2a5-d4213912ee18
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column vr_comissao = fEntregas[vr_liquido_final] * fEntregas[comissao_prazo]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 433a61c3-c96a-4989-b272-611abc6d098b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column rateio = [Rateio de despesas/Custos]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ad60abb8-30d5-481c-894a-5d25538de4a9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column TemPagto3 =
			
			VAR vCodVenda = fEntregas[vend_cod_venda]
			RETURN
			IF(
			    CALCULATE(
			        COUNTROWS(fRecebidos),
			        FILTER(
			            fRecebidos,
			            fRecebidos[fat_cod_venda] = vCodVenda &&
			            fRecebidos[cod_pagto] = 3
			        )
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: fb693a37-1123-4c33-8b3f-1c8a6f74b71e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column taxa_cartao =
			
			IF(
			    fEntregas[TemPagto3] = 1,
			    [Taxa de Cartão de Crédito],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e25b37b2-4f1e-4db1-a3a2-47d7bec68559
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Num_Entrega
		dataType: int64
		formatString: 0
		lineageTag: 47bc3f80-6c3d-4de6-b512-0f49e73af74e
		summarizeBy: sum
		sourceColumn: Num_Entrega

		annotation SummarizationSetBy = Automatic

	column vr_liquido_final = fEntregas[vr_unitario_liquido] * fEntregas[qtd]
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		lineageTag: 3b02e330-99c6-48db-9077-a779a55a28bf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	column numero_nfe =
			
			VAR vVenda = fEntregas[vend_cod_venda]
			VAR vProd  = fEntregas[cod_prod]
			RETURN
			CONCATENATEX(
			    DISTINCT(
			        FILTER(
			            fNotas_Fiscais_Saida,
			            fNotas_Fiscais_Saida[venda_cod_venda] = vVenda &&
			            fNotas_Fiscais_Saida[cod_prod] = vProd &&
			            fNotas_Fiscais_Saida[cod_cfop] <> "5929"
			        )
			    ),
			    fNotas_Fiscais_Saida[numero_nf],
			    "; "
			)
		lineageTag: d222eb4f-da5c-4041-b6a4-2bec585c197a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'rateio geral' = [Rateio de despesas/Custos Geral]
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 91fd51ad-2c77-447e-819f-6a1812da0b4e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

