				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Linhas Classificadas",{{"vend_cod_venda", type text}, {"preco_custo", Currency.Type}, {"vr_unitario", Currency.Type}, {"vr_bruto", Currency.Type}, {"vr_desconto", Currency.Type}, {"vr_liquido", Currency.Type}, {"vr_acrescimo", Currency.Type}, {"pis_base_calculo", Currency.Type}, {"pis_valor", Currency.Type}, {"cofins_base_calculo", Currency.Type}, {"cofins_valor", Currency.Type}, {"imposto_base_calculo", Currency.Type}, {"imposto_valor", Currency.Type}, {"vr_desconto_venda", Currency.Type}, {"vr_acrescimo_venda", Currency.Type}, {"pis_aliq", Percentage.Type}, {"cofins_aliq", Percentage.Type}, {"imposto_aliq", Percentage.Type}}),
				    #"Coluna Duplicada" = Table.DuplicateColumn(#"Tipo Alterado", "cod_carregamento", "cod_carregamento - Copiar"),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Coluna Duplicada",{{"cod_carregamento - Copiar", "Num_Entrega"}}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Colunas Renomeadas",{{"Num_Entrega", Int64.Type}})
				in
				    #"Tipo Alterado1"

	annotation PBI_NavigationStepName = Navegação

