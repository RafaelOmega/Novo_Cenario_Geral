	measure 'Faturamento PA R$' =
			
			SWITCH(
			    TRUE(),
			    ISINSCOPE(dCalendario[Ano]), [R$ Faturamento AA],
			    ISINSCOPE(dCalendario[MesAno]), [R$ Faturamento MA],
			    ISINSCOPE(dCalendario[SemanaMesAno]), [R$ Faturamento SA],
			    BLANK()
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1 - Vendas\Faturamento
		lineageTag: 37b3963f-e06a-4c11-b337-1b39c8fdb8eb

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Faturamento PA %' =
			
			// SWITCH(
			//     TRUE();
			//     ISINSCOPE(dCalendario[Ano]); [Faturamento AA %];
			//     ISINSCOPE(dCalendario[MesAno]); [Faturamento MA %];
			//     ISINSCOPE(dCalendario[SemanaMesAno]); [Faturamento SA %];
			//     BLANK()
			// )
			VAR Nivel =
			    SWITCH(
			        TRUE(),
			        ISINSCOPE(dCalendario[SemanaMesAno]), "Semana",
			        ISINSCOPE(dCalendario[MesAno]), "Mes",
			        ISINSCOPE(dCalendario[Ano]), "Ano",
			        "Total"
			    )
			RETURN
			SWITCH(
			    Nivel,
			    "Semana", [% Faturamento SA],
			    "Mes", [% Faturamento MA],
			    "Ano", [% Faturamento AA],
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 1 - Vendas\Faturamento
		lineageTag: d9a101a7-8aa8-47c9-aaa9-6d1333cbd6c1

