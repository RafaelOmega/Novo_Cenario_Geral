		lineageTag: 12ce0a1e-05fa-4500-b74f-b4c6df9253d1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Taxa de Cartão de Crédito' = [Taxa de Cartão de Crédito (baseado no HOJE)]
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 4 - Markup\Base
		lineageTag: 80f17731-0db9-42d3-a2d3-69fe11f5496f

	measure 'Taxa de Cartão de Crédito (baseado no HOJE)' =
			
			VAR DataRef = MAX('dCalendario'[Data])
			VAR InicioMesAtual = DATE(YEAR(DataRef), MONTH(DataRef), 1)
			VAR InicioMesAnterior = EDATE(InicioMesAtual, -1)
			VAR FimMesAnterior = EOMONTH(InicioMesAtual, -1)
			RETURN
			CALCULATE(
			    DIVIDE(SUM(fOperadoras[VALOR TAXA]), SUM(fOperadoras[VALOR])),
			    'dCalendario'[Data] >= InicioMesAnterior,
			    'dCalendario'[Data] <= FimMesAnterior
			)
		displayFolder: 4 - Markup\Base
		lineageTag: bca3b407-a32b-4254-80e3-ec08370ba112

		annotation PBI_FormatHint = {"isGeneralNumber":true}

