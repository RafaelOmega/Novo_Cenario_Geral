	measure 'Margem Liquida Eixo Y Dinamico' = ```
			
			VAR vTabela = 
			    ALLSELECTED(dCalendario[Mes], dCalendario[MesNum])
			VAR vMaior_Valor = 
			    MAXX(
			        vTabela,
			        [Margem Liquida]
			    )
			VAR vDeslocamento = 1.30
			RETURN
			vMaior_Valor * vDeslocamento
			```
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
