	measure 'Comissão sobre Entrega' =
			
			CALCULATE(
			    SUMX(
			        fEntregas,
			        fEntregas[comissao_prazo] * fEntregas[vr_liquido_final]
			    )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Entregas
		lineageTag: 63c3ea3e-08f4-4c75-8a69-e73a7640a521

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'ICMS Sobre a Entrega' =
			
			IF(
			    SELECTEDVALUE(fEntregas[numero_nfe]) <> " ",
			        CALCULATE(
			            SUMX(
			                fEntregas,
			                fEntregas[icms_aliq_Nfe] * fEntregas[vr_liquido_final]
			            )
			        ),
			        CALCULATE(
			            SUMX(
			                fEntregas,
			                fEntregas[imposto_aliq] * fEntregas[vr_liquido_final]
			            )
			        )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Entregas
		lineageTag: 755c8de4-8032-47a7-a250-0c50db4cb805

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'PIS/COFINS sobre a Entrega' =
			
			IF(
			    SELECTEDVALUE(fEntregas[numero_nfe]) <> " ",
			        CALCULATE(
			            SUMX(
			                fEntregas,
			                fEntregas[pis_cofins_nfe] * fEntregas[vr_liquido_final]
			            )
			        ),
			        CALCULATE(
			            SUMX(
			                fEntregas,
			                fEntregas[pis_cofins_aliq] * fEntregas[vr_liquido_final]
			            )
			        )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Entregas
		lineageTag: d3e1794d-8457-4d7d-81f8-96ab5323e9e1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Rateio de despesas/Custos Entrega' =
			
			CALCULATE(
			    SUMX(
			        fEntregas,
			        fEntregas[rateio] * fEntregas[vr_liquido_final]
			    )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Entregas
		lineageTag: a2e50fec-45d9-4a39-bf80-7afe932b14cb

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Taxa de Cartão de Crédito Entrega' =
			
			CALCULATE(
			    SUMX(
			        fEntregas,
			        fEntregas[taxa_cartao] * fEntregas[vr_liquido_final]
			    )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Entregas
		lineageTag: 28463194-fe68-4726-ba42-d90c585e96a8

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Lucro Liquido Entrega' =
			
			[Faturamento_Entregas]
			- [Custo_Entregas]
			- [Rateio de despesas/Custos Entrega]
			- [Taxa de Cartão de Crédito Entrega]
			- [Comissão sobre Entrega]
			- [ICMS Sobre a Entrega]
			- [PIS/COFINS sobre a Entrega]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Entregas
