	measure 'Resultato Final Filtro' = ```
			
			SUMX(
			    VALUES(
			        fRecebidos[bxa_data_recebimento]),
			        CALCULATE(
			            SUM(fRecebidos[liquido_rateado])
			        )
			) + 
			SUMX(
			    VALUES(
			        fPagos[data_pagamento]),
			        CALCULATE(
			            SUM(fPagos[vr_liquido_rateio])
			        )
			)
			```
