	measure Custo_Entregas =
			
			CALCULATE(
			    SUMX(
			        fEntregas,
			        fEntregas[preco_custo] * fEntregas[qtd]
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
