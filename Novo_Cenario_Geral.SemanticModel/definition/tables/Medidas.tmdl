	measure 'Markup IF' = ```
			
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "ADUBO AGROSAFRA", -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "ADUBO REAL", -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "ADUBO HERINGER" , -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "ADUBOS FERTIPAR" , -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PESADOS ADUBOS" , -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "AREIA PARA GATOS" , 20 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "CALCARIO" , 7 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "ADUBO PROVASO" , 7 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES BLESSAM" , 3 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES GUABI", -7 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES DA FABRICA" , -3 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "FARDOS CONTROLADOS", -3 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PESADOS CONTROLADOS", -3 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "DERIVADOS DO MILHO" , -6 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "FARELOS" , -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "INSUMOS" , 0 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "MILHO" , -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "SAL COMUM" , -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES GRANVITA CAES" , -7 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES GRANVITA GATOS" , -7 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES RAMINELLI", 4 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES TOTAL", 3 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES PASSAROS", -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES SUPRA", 3 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PESADOS RACOES PASSAROS", -5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PASSARINHEIRO", 5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "RACOES PET PREMIER", -15 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PREMIER PET VITTA", 5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PRODUTOS PISCINA HIDROAZUL", -7 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PRODUTOS PISCINA CRIS AGUA", -10 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PRODUTOS PISCINA DOMCLOR", -10 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "SEMENTES MILHO DI SOLO", 5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "SEMENTES FEIJAO DI SOLO", 5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PESADOS SEMENTES MILHO DI SOLO", 5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "PESADOS SEMENTES FEIJAO DI SOLO", 5 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_GRUPO]) = "FERRADURAS", 0 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_PRODUTO]) = "BLESSAM 18% 15KG", 4 / 100,
			    IF(SELECTEDVALUE(dProdutos[DESC_PRODUTO]) = "BLESSAM 22% 15KG", 19 / 100,
			    5 / 100)
			)))))))))))))))))))))))))))))))))))))
			```
		displayFolder: 4 - Markup\Base
		lineageTag: 6f0e8646-07ec-4211-8c59-85b8c1cc1869

