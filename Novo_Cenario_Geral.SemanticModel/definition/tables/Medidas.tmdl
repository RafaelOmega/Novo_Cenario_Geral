	measure 'Resultado Final Mês Anterior (baseado no HOJE)' =
			
			VAR DataRef = MAX('dCalendario'[Data])
			VAR InicioMesAtual = DATE(YEAR(DataRef), MONTH(DataRef), 1)
			VAR InicioMesAnterior = EDATE(InicioMesAtual, -1)
			VAR FimMesAnterior = EOMONTH(InicioMesAtual, -1)
			
			// VAR vCCsGrupo =
			//     CALCULATETABLE(
			//         VALUES(dGrupo_Centro_Custos[COD]);
			//         ALLSELECTED(dGrupo_Centro_Custos)
			//     )
			
			VAR vCCsGrupo =
			    CALCULATETABLE(
			        VALUES(dGrupo_Centro_Custos[COD]),
			        dGrupo_Centro_Custos[GRUPO] = "Agropecuaria"
			    )
			
			RETURN
			CALCULATE(
			    SUM(fRecebidos[liquido_rateado]),
			    'dCalendario'[Data] >= InicioMesAnterior,
			    'dCalendario'[Data] <= FimMesAnterior,
			    TREATAS(vCCsGrupo, fRecebidos[cod_cc])
			)
			+
			CALCULATE(
			    SUM(fPagos[vr_liquido_rateio]),
			    'dCalendario'[Data] >= InicioMesAnterior,
			    'dCalendario'[Data] <= FimMesAnterior,
			    TREATAS(vCCsGrupo, fPagos[cod_cc])
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 4 - Markup\Base
		lineageTag: d8f785a2-3192-4d31-8b42-fa8653ef2ebd

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Resultato Final' = [Resultado Final Mês Anterior (baseado no HOJE)]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
