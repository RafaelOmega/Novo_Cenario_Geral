	measure 'Pagos Eixo Y Dinamico' = ```
			
			VAR vTabela = 
			    ALLSELECTED(dCalendario[Mes], dCalendario[MesNum])
			VAR vMaior_Valor = 
			    MAXX(
			        vTabela,
			        [Pagos]
			    )
			VAR vDeslocamento = 1.30
			RETURN
			vMaior_Valor * vDeslocamento
			```
