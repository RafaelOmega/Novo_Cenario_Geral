	measure 'Comissão sobre Venda' =
			
			CALCULATE(
			    SUMX(
			        fVendas,
			        fVendas[comissao_prazo] * fVendas[vr_liquido_final]
			    )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 4 - Markup\Vendas
		lineageTag: 88cd8f14-ae86-4a77-a676-5a66fde34e06

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'ICMS Sobre a Venda' =
			
			IF(
			    SELECTEDVALUE(fVendas[numero_nfe]) <> " ",
			        CALCULATE(
			            SUMX(
			                fVendas,
			                fVendas[icms_aliq_Nfe] * fVendas[vr_liquido_final]
			            )
			        ),
			        CALCULATE(
			            SUMX(
			                fVendas,
			                fVendas[imposto_aliq] * fVendas[vr_liquido_final]
			            )
			        )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 4 - Markup\Vendas
		lineageTag: 7e72c144-7fc3-4cba-8f2f-f291e068bc7c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'PIS/COFINS sobre a Venda' =
			
			IF(
			    SELECTEDVALUE(fVendas[numero_nfe]) <> " ",
			        CALCULATE(
			            SUMX(
			                fVendas,
			                fVendas[pis_cofins_nfe] * fVendas[vr_liquido_final]
			            )
			        ),
			        CALCULATE(
			            SUMX(
			                fVendas,
			                fVendas[pis_cofins_aliq] * fVendas[vr_liquido_final]
			            )
			        )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 4 - Markup\Vendas
		lineageTag: beaed5c1-1725-4fe2-bddb-7bb588c78475

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Rateio de despesas/Custos Venda' =
			
			CALCULATE(
			    SUMX(
			        fVendas,
			        fVendas[rateio] * [vr_liquido_final]
			    )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 4 - Markup\Vendas
		lineageTag: d1ad46f4-814b-4362-9cd7-2bb790192b9d

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Taxa de Cartão de Crédito Venda' =
			
			CALCULATE(
			    SUMX(
			        fVendas,
			        fVendas[taxa_cartao] * fVendas[vr_liquido_final]
			    )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 4 - Markup\Vendas
		lineageTag: badc5cb9-fdf5-477e-8acd-0dacbaf25efc

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Lucro Liquido' =
			
			[Faturamento]
			- [Custo]
			- [Rateio de despesas/Custos Venda]
			- [Taxa de Cartão de Crédito Venda]
			- [Comissão sobre Venda]
			- [ICMS Sobre a Venda]
			- [PIS/COFINS sobre a Venda]
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 4 - Markup\Vendas
		lineageTag: aa93243a-1215-475c-8988-2c7490f2b651

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Markup Venda' =
			
