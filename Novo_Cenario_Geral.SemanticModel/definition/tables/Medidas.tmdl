	measure 'Faturamento Card Subtitulo' = ```
			
			VAR vMelhor_Mes_Tabela = 
			    TOPN(
			        1,
			        ALL(dCalendario[Mes], dCalendario[MesNum]),
			        [Faturamento],DESC)
			VAR vMelhor_Mes = MAXX(vMelhor_Mes_Tabela, dCalendario[Mes])
			RETURN
			"(" & vMelhor_Mes & ")" & " Melhor Mês"
			```
		displayFolder: 1 - Vendas\Faturamento
		lineageTag: 9fb05297-3a58-47ac-9e80-d168f871dc79

	measure 'Faturamento Eixo Y Dinamico' = ```
			
			VAR vTabela = 
			    ALLSELECTED(dCalendario[Mes], dCalendario[MesNum])
			VAR vMaior_Valor = 
			    MAXX(
			        vTabela,
			        [Faturamento]
			    )
			VAR vDeslocamento = 1.30
			RETURN
			vMaior_Valor * vDeslocamento
			```
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: 1 - Vendas\Faturamento
		lineageTag: 6d9c63a5-c298-4fb9-abbe-f7524c541726

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Faturamento % Cresc' = DIVIDE([Faturamento] - [Faturamento LY], [Faturamento LY])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 1 - Vendas\Faturamento
		lineageTag: b0d8dc58-2e21-4cd4-a6a4-11fcfd3d5323

	measure 'Faturamento Format. Cond. Cresc' =
			
			IF(
			    [Faturamento % Cresc] >= 0,
			    "#92D050",
			    "#D05050"
			)
		displayFolder: 1 - Vendas\Faturamento
		lineageTag: 277ec7b5-83e4-442a-9f1f-9266d3dee1a1

	measure 'Faturamento Rotulo LY' =
			
			VAR vValor = [Faturamento]
			VAR vDeslocamento = [Faturamento Eixo Y Dinamico] * 0.08
			
			RETURN
			vValor + vDeslocamento
		displayFolder: 1 - Vendas\Faturamento
		lineageTag: 00222b31-f934-4e51-a2c9-387c5018f635

		formatStringDefinition = ```
				VAR vPorcentagem = [Faturamento % Cresc]
				VAR vPOrcentagem_Formatada = 
				   IF(
				       vPorcentagem >= 0,
				        FORMAT(vPorcentagem, "⮝ 0.00%"),
				        FORMAT(vPorcentagem, "⮟ 0.00%")
				   )
				RETURN
				"""" & vPOrcentagem_Formatada & """"
				```

