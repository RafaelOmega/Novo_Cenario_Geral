		lineageTag: 29e0dcaa-4b52-4994-9fea-0571bcb57928

	measure 'Margem Liquida Geral' =
			
			[Faturamento] * [Markup Venda Geral]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 4 - Markup\Vendas
		lineageTag: 4f9da6d7-eb8c-463c-8b18-b225672c472a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Lucro Liquido Entrega Geral' =
			
			[Faturamento_Entregas]
			- [Custo_Entregas]
			- [Rateio de despesas/Custos Entrega Geral]
			- [Taxa de Cartão de Crédito Entrega]
			- [Comissão sobre Entrega]
			- [ICMS Sobre a Entrega]
			- [PIS/COFINS sobre a Entrega]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Entregas
		lineageTag: 867b5d72-b95f-45c3-84f4-2c3bfa525eff

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Rateio de despesas/Custos Entrega Geral' =
			
			CALCULATE(
			    SUMX(
			        fEntregas,
			        fEntregas[rateio geral] * fEntregas[vr_liquido_final]
			    )
			)
		formatString: "R$"\ #,0.###############;-"R$"\ #,0.###############;"R$"\ #,0.###############
		displayFolder: Entregas
		lineageTag: 07213b13-3e29-462c-87e5-00f70a7149c6

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Markup Entregas Geral' =
			
			DIVIDE([Lucro Liquido Entrega Geral], [Faturamento_Entregas])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Entregas
		lineageTag: ebfdc8fb-a85e-46ce-9c81-fc9a23e6ec71

