	measure 'Média Prazo Recebimento Previsto' =
			
			// AVERAGE(fRecebidos[prazo])
			CALCULATE(
			    AVERAGE(fRecebidos[prazo]),
			    FILTER(
			        dClientes,
			        dClientes[Cód + Cliente] <> "2 - VENDA A CONSUMIDOR"
			    )
			)
		formatString: 0.00
		displayFolder: 2 - Financeiro\Recebidos\Percentuais
		lineageTag: 80e490ba-76dd-4d4f-96be-7a9dd8b16e68

	measure 'Média Prazo Recebimento Real' =
			
			// AVERAGEX(fRecebidos; fRecebidos[prazo] + fRecebidos[atraso] - fRecebidos[antecipados])
			CALCULATE(
			    AVERAGEX(fRecebidos, fRecebidos[prazo] + fRecebidos[atraso] - fRecebidos[antecipados]),
			    FILTER(
			        dClientes,
			        dClientes[Cód + Cliente] <> "2 - VENDA A CONSUMIDOR"
			    )
			)
		formatString: 0.00
		displayFolder: 2 - Financeiro\Recebidos\Percentuais
		lineageTag: 20360139-bb46-44d3-a478-db8a9d30c9a3

