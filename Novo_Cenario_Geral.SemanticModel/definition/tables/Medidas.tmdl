	measure Faturamento =
			
			SUMX(
			    fVendas,
			    fVendas[vr_liquido_final]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1 - Vendas\Faturamento
		lineageTag: 1497727f-f36f-4d77-9ea7-3735de4c4750

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Qtde =
			
			SUMX(
			    fVendas,
			    fVendas[qtd_liquida]
			)
		formatString: #,0.00
		displayFolder: 1 - Vendas\Qtde
		lineageTag: 076cb194-6ad7-4acb-b4bf-a6c8561bdcdb

	measure Custo =
			
			CALCULATE(
			    SUMX(
			        fVendas,
			        fVendas[preco_custo] * fVendas[qtd_liquida]
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 1 - Vendas\Custo
		lineageTag: 3f579ef0-61e9-45d1-8768-8369a3f0636b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Margem Bruta' = [Faturamento] - [Custo]
