	measure 'Titulo Faturamento Relativo' =
			
			VAR vMaior_Data = FORMAT(MAX(dCalendario[Data]), "dd/mm/yyyy")
			VAR vMenor_Data = FORMAT(MIN(dCalendario[Data]), "dd/mm/yyyy")
			VAR vVendedor = SELECTEDVALUE(dVendedores[vendedor], "Todos")
			VAR vCliente = SELECTEDVALUE(dClientes[cliente], "Todos")
			VAR vSetor = SELECTEDVALUE(dClientes[setor], "Todos")
			VAR vProdutos = SELECTEDVALUE(dProdutos[desc_produto], "Todos")
			RETURN
			"Filtros Aplicados: " &
			" - Inicio: " & vMenor_Data &
			" - Fim: " & vMaior_Data &
			" - Vendedor: " & vVendedor &
			" - Cliente: " & vCliente &
