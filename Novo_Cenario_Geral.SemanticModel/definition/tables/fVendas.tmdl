	column comissao_prazo =
			
			VAR vVendedor = fVendas[cod_vendedor]
			VAR vUnit     = fVendas[vr_unitario_liquido]
			VAR vData     = fVendas[DATA]
			VAR vPrecoPrazo = RELATED(dProdutos[preco_prazo])
			VAR vPrecoVista = RELATED(dProdutos[preco_vista])
			RETURN
			IF(
			    NOT ( vVendedor IN {165,234,236,237,238,248,250,2858,2885,3025,3065,3174} ),
			    0,
			    IF(
			        vVendedor = 234,
			        0.05,
			        IF(
			            vVendedor = 2858,
			            0.03,
			            IF(
			                vVendedor = 2885,
			                0.03,
			                IF(
			                    vVendedor = 3025,
			                    0.05,
			                    IF(
			                        vVendedor = 3174,
			                        IF(
			                            vData <= DATE(2026, 1, 31),
			                            SWITCH(
			                                TRUE(),
			                                vUnit >= vPrecoPrazo, 0.05,
			                                vUnit < vPrecoPrazo && vUnit >= vPrecoVista, 0.04,
			                                vUnit < vPrecoVista, 0.02,
			                                RELATED(dProdutos[perc_comissao_prazo])
			                            ),
			                            0.04
			                        ),
			                        RELATED(dProdutos[perc_comissao_prazo])
			                    )
			                )
			            )
			        )
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 032f518b-75d8-4ee5-a9d7-ef5f8b5b857c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column rateio = [Rateio de despesas/Custos]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e2a82df2-f0a2-46df-8f44-950c94665222
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column taxa_cartao =
			
			IF(
			    fVendas[TemPagto3] = 1,
			    [Taxa de Cartão de Crédito],
			    0
			)
		lineageTag: 77c7b751-d7ab-45e6-83d1-2d36a0f7a7fe
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column TemPagto3 =
			
			VAR vCodVenda = fVendas[cod_venda]
			RETURN
			IF(
			    CALCULATE(
			        COUNTROWS(fRecebidos),
			        FILTER(
			            fRecebidos,
			            fRecebidos[fat_cod_venda] = vCodVenda &&
			            fRecebidos[cod_pagto] = 3
			        )
			    ) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: 54418743-2105-4135-9c29-b20036a9bcb9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column numero_nfe =
			
			VAR vVenda = fVendas[cod_venda]
			VAR vProd  = fVendas[cod_prod]
			RETURN
			CONCATENATEX(
			    DISTINCT(
			        FILTER(
			            fNotas_Fiscais_Saida,
			            fNotas_Fiscais_Saida[venda_cod_venda] = vVenda &&
			            fNotas_Fiscais_Saida[cod_prod] = vProd &&
			            fNotas_Fiscais_Saida[cod_cfop] <> "5929"
			        )
			    ),
			    fNotas_Fiscais_Saida[numero_nf],
			    "; "
			)
		lineageTag: c358719a-8de2-4c6f-8f0b-af8178cf6b5d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column pis_aliq_Nfe =
			
			VAR vVenda = fVendas[cod_venda]
			VAR vProd  = fVendas[cod_prod]
			VAR vAliq =
			    CALCULATE(
			        MAX(fNotas_Fiscais_Saida[pis_aliq]),
			        FILTER(
			            fNotas_Fiscais_Saida,
			            fNotas_Fiscais_Saida[venda_cod_venda] = vVenda &&
			            fNotas_Fiscais_Saida[cod_prod] = vProd &&
			            fNotas_Fiscais_Saida[cod_cfop] <> "5929"
			        )
			    )
			RETURN
			COALESCE(vAliq, 0)
		lineageTag: 353a5183-5f75-421b-9cc9-f077014e96ad
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column cofins_aliq_Nfe =
			
			VAR vVenda = fVendas[cod_venda]
			VAR vProd  = fVendas[cod_prod]
			VAR vAliq =
			    CALCULATE(
			        MAX(fNotas_Fiscais_Saida[cofins_aliq]),
			        FILTER(
			            fNotas_Fiscais_Saida,
			            fNotas_Fiscais_Saida[venda_cod_venda] = vVenda &&
			            fNotas_Fiscais_Saida[cod_prod] = vProd &&
			            fNotas_Fiscais_Saida[cod_cfop] <> "5929"
			        )
			    )
			RETURN
			COALESCE(vAliq, 0)
		lineageTag: a3903df2-7c2e-4447-a617-ad50b7a1d2e4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

